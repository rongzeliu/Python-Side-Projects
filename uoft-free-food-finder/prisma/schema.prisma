generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  hostClub    String
  description String
  startAt     DateTime
  endAt       DateTime?
  building    String
  room        String?
  lat         Float
  lng         Float
  foodType    String
  dietary     String[]
  source      String
  sourceUrl   String
  imageUrl    String?
  approved    Boolean   @default(true)
  externalId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startAt])
  @@index([approved])
}
