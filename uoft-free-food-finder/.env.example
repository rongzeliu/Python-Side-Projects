# PostgreSQL (used when you run docker compose + prisma migrate)
DATABASE_URL="postgresql://uoft:uoft@localhost:5432/free_food?schema=public"

# Mapbox is optional. Without it the map uses OpenStreetMap tiles via Leaflet.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Instagram / Apify (optional). Without a token, the Instagram source uses fixture captions.
APIFY_TOKEN=""
APIFY_INSTAGRAM_ACTOR="apify/instagram-scraper"

# Official Graph / RSS keys if you add them later
INSTAGRAM_ACCESS_TOKEN=""

# Comma-separated Instagram handles to monitor
INSTAGRAM_HANDLES="uoftsu,utsu_uoft,newcollegesu,trinitycollegeuoft,vusu_uoft,smcsu,inniscollege,uc_lit"

# Optional. If set, POST /api/scrape requires header x-scrape-secret.
# Leave empty so the Submit page "Ingest sources now" button works locally.
SCRAPE_SECRET=""
